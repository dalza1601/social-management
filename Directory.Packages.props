<Project>
  <!--
    Central Package Management: las versiones de todos los paquetes NuGet se definen aquí.
    Los .csproj usan <PackageReference Include="..." /> sin atributo Version.
    Se usan versiones estables compatibles con .NET 10 LTS (rama 10.0.x de Microsoft).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Las versiones definidas aquí también se aplican a las dependencias transitivas. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Correcciones de seguridad (dependencias transitivas)">
    <!-- Microsoft.Data.SqlClient 6.1.7 trae la 9.0.x, con avisos GHSA-2fmv-rv2c-59x7 y GHSA-846f-f764-76mx. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core / Extensions">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Interfaz Swagger UI (sin el generador de Swashbuckle: el documento lo crea Microsoft.AspNetCore.OpenApi). -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
    <!-- Versionado de APIs en la URL (api/v{version:apiVersion}/[controller]) y un documento OpenAPI por versión. -->
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <!-- Autenticación JWT Bearer (sesión 04): valida firma, emisor, audiencia y expiración de los tokens. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Validación (capa Application)">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Persistencia">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <!-- Misma versión que usa EF Core 10.0.15 (la 7.x arrastra System.Security.Cryptography.Pkcs vulnerable). -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.7" />
  </ItemGroup>

  <ItemGroup Label="Mensajería, AWS y Gateway">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.12" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.26" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Pruebas">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- FakeTimeProvider: reloj controlable para pruebas (sesión 01). -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>

# Plantilla procesada con envsubst al arrancar el contenedor.
# Solo se reemplazan variables de entorno definidas (p. ej. GATEWAY_UPSTREAM);
# las variables propias de nginx ($uri, $host...) se conservan.

server {
    listen       8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # DNS interno de Docker: resuelve "gateway" en cada petición (tolera reinicios del contenedor).
    resolver 127.0.0.11 valid=10s ipv6=off;

    # /gateway/*  ->  API Gateway (el prefijo /gateway se elimina).
    # El navegador llama siempre al mismo origen: no se necesita CORS ni URLs absolutas en Angular.
    # "^~" da prioridad a esta ruta sobre las expresiones regulares de más abajo.
    location ^~ /gateway/ {
        set $gateway_upstream ${GATEWAY_UPSTREAM};
        rewrite ^/gateway/(.*)$ /$1 break;
        proxy_pass $gateway_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    # Aplicación de una sola página: las rutas de Angular devuelven index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Los archivos con hash en el nombre pueden almacenarse en caché por largo tiempo.
    location ~* \.(?:js|css|woff2?|png|svg|ico)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
}

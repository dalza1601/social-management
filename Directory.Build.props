<Project>
  <!--
    Propiedades comunes a todos los proyectos .NET del repositorio.
    Cada .csproj solo declara lo que lo hace distinto (referencias y paquetes).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>

    <Version>0.1.0</Version>
    <Product>SocialManagement</Product>
    <Company>SocialManagement</Company>

    <!-- En CI (GitHub Actions define CI=true) cualquier advertencia rompe la compilación. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  // Rutas públicas del Gateway -> microservicios.
  // El prefijo público se elimina antes de reenviar:
  //   GET /api/beneficiarios/version  ->  GET {beneficiarios-api}/version
  // Las direcciones de destino por defecto apuntan a los servicios ejecutados en el host
  // (dotnet run o contenedores publicados en 8081/8082). En Docker se sobrescriben con
  // variables de entorno para usar el DNS de Compose (http://beneficiarios-api:8080/).
  "ReverseProxy": {
    "Routes": {
      // X-Forwarded-Prefix informa al servicio del prefijo público eliminado, para que su documento
      // OpenAPI y Swagger UI generen URLs correctas (https://dominio/api/beneficiarios/...).
      // "Prefix": "Off" desactiva el valor automático de YARP (vacío) para que no lo sobrescriba.
      "beneficiarios-route": {
        "ClusterId": "beneficiarios",
        "Match": { "Path": "/api/beneficiarios/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/beneficiarios" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api/beneficiarios" }
        ]
      },
      // Recursos de negocio versionados (sesión 03): la ruta pública ES la ruta del servicio, sin quitar prefijo.
      //   POST /api/v1/beneficiarios  ->  POST {beneficiarios-api}/api/v1/beneficiarios
      // La restricción v<número> evita que capture otras rutas (/api/beneficiarios/... la atiende la ruta anterior).
      "beneficiarios-versioned-route": {
        "ClusterId": "beneficiarios",
        "Match": { "Path": "/api/{version:regex(^v\\d+$)}/beneficiarios/{**catch-all}" }
      },
      "solicitudes-route": {
        "ClusterId": "solicitudes",
        "Match": { "Path": "/api/solicitudes/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/solicitudes" },
          { "X-Forwarded": "Set", "Prefix": "Off" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api/solicitudes" }
        ]
      }
    },
    "Clusters": {
      "beneficiarios": {
        "Destinations": {
          "default": { "Address": "http://localhost:8081/" }
        }
      },
      "solicitudes": {
        "Destinations": {
          "default": { "Address": "http://localhost:8082/" }
        }
      }
    }
  }
}

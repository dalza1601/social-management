{
  // La cadena de conexión y las credenciales de RabbitMQ NO se escriben aquí:
  // scripts/setup.ps1 las guarda en user-secrets a partir de .env.
  // Dentro de Docker llegan como variables de entorno (ver infra/docker/docker-compose.yml).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672
  },
  "ApiDocumentation": {
    "Enabled": true
  },
  // Publica POST /api/auth/dev-token (sesión 04). Usuarios demo: user-secrets, ver scripts/setup.ps1 y .env.example.
  "DevelopmentTokens": {
    "Enabled": true
  }
}

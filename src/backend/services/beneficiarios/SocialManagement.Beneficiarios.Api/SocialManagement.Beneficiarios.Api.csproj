<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Capa de PRESENTACIÓN (API REST).
    Regla: depende de Application e Infrastructure. Los controllers no contienen lógica de negocio.
  -->
  <PropertyGroup>
    <RootNamespace>SocialManagement.Beneficiarios.Api</RootNamespace>
    <!-- Permite guardar secretos locales con: dotnet user-secrets set "clave" "valor" -->
    <UserSecretsId>social-management-beneficiarios-api</UserSecretsId>
    <!-- Los comentarios XML (///) se incorporan al documento OpenAPI: resúmenes, parámetros y respuestas. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: no exigir comentarios XML en todos los miembros públicos. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialManagement.Beneficiarios.Application\SocialManagement.Beneficiarios.Application.csproj" />
    <ProjectReference Include="..\SocialManagement.Beneficiarios.Infrastructure\SocialManagement.Beneficiarios.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Solo la interfaz Swagger UI; el documento lo genera Microsoft.AspNetCore.OpenApi. -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!-- Versionado por URL (incluye Asp.Versioning.Mvc.ApiExplorer) y un documento OpenAPI por versión. -->
    <PackageReference Include="Asp.Versioning.OpenApi" />
    <!-- JWT Bearer (sesión 04). Trae Microsoft.IdentityModel.JsonWebTokens, usado también para emitir los tokens de desarrollo. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Necesario para "dotnet ef migrations" usando este proyecto como startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SocialManagement.Beneficiarios.Api.IntegrationTests" />
  </ItemGroup>

</Project>

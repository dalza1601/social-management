{
  "ServiceInfo": {
    "Name": "beneficiarios-api",
    "Description": "Microservicio de gestión de beneficiarios"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Swagger UI (/swagger) y documento OpenAPI (/openapi/v1.json). Deshabilitado por defecto:
  // se habilita en appsettings.Development.json y appsettings.Staging.json, o con ApiDocumentation__Enabled.
  // En Production exige Access (credenciales por variable de entorno; nunca aquí).
  "ApiDocumentation": {
    "Enabled": false,
    "RoutePrefix": "swagger",
    "Access": {
      "UserName": "",
      "Password": ""
    }
  },
  // Proxies de confianza para X-Forwarded-*: loopback siempre; agrega aquí o por variables de entorno
  // la IP o red del Gateway/ingress (p. ej. ForwardedHeaders__KnownNetworks__0=172.16.0.0/12).
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ConnectionStrings": {
    "BeneficiariosDb": ""
  },
  // Autenticación JWT (sesión 04). SigningKey es un SECRETO: user-secrets (scripts/setup.ps1) o Jwt__SigningKey.
  // Mínimo 32 bytes. Nunca se escribe aquí.
  "Jwt": {
    "Issuer": "social-management-dev",
    "Audience": "social-management-api",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  // POST /api/auth/dev-token: tokens para usuarios demo, SOLO en Development (ver appsettings.Development.json).
  // Los usuarios (UserName, Password, Roles) llegan por user-secrets o variables de entorno, nunca por este archivo.
  "DevelopmentTokens": {
    "Enabled": false
  },
  // true: aplica las migraciones de EF Core pendientes al iniciar (activado en Docker Compose).
  // Localmente: dotnet ef database update (ver docs/sessions/session-03.md).
  "Persistence": {
    "ApplyMigrationsAtStartup": false
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "VirtualHost": "social-management",
    "UserName": "",
    "Password": "",
    "ClientProvidedName": "beneficiarios-api"
  },
  "Aws": {
    "Region": "us-east-1",
    "UseLocalStack": true,
    "ServiceUrl": "http://localhost:4566",
    "AccessKey": "test",
    "SecretKey": "test",
    "DocumentsBucketName": "social-management-documents-dev",
    "NotificationsQueueName": "social-management-notifications-dev"
  },
  "Ollama": {
    "Enabled": false,
    "Endpoint": "http://localhost:11434",
    "ModelId": ""
  }
}

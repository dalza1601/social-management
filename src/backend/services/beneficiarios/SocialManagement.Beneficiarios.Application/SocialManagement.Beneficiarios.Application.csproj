<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capa de APLICACIÓN.
    Regla: solo depende de Domain. Se permiten la abstracción de DI de Microsoft (solo la interfaz
    IServiceCollection), FluentValidation (validación) y AutoMapper (mapeo); ninguna es HTTP ni infraestructura.
  -->
  <PropertyGroup>
    <RootNamespace>SocialManagement.Beneficiarios.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialManagement.Beneficiarios.Domain\SocialManagement.Beneficiarios.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Validación de los datos de entrada (comandos y consultas) antes de crear objetos de dominio. -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- Mapeo entidad → DTO con perfiles (carpeta Mappings) y registro con AddAutoMapper. -->
    <PackageReference Include="AutoMapper" />
  </ItemGroup>

</Project>

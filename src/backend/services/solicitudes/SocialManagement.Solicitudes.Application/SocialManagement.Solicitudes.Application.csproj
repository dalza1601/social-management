<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capa de APLICACIÓN.
    Regla: solo depende de Domain. Se permiten la abstracción de DI de Microsoft (solo la interfaz
    IServiceCollection) y FluentValidation (biblioteca de validación, sin HTTP ni infraestructura).
  -->
  <PropertyGroup>
    <RootNamespace>SocialManagement.Solicitudes.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SocialManagement.Solicitudes.Domain\SocialManagement.Solicitudes.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Validación de los datos de entrada (comandos y consultas) antes de crear objetos de dominio. -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

</Project>

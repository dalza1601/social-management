# =====================================================================
#  SocialManagement - Variables de entorno de DESARROLLO LOCAL
# ---------------------------------------------------------------------
#  1. Copia este archivo como ".env" (scripts/setup.ps1 lo hace por ti).
#  2. ".env" está en .gitignore: NUNCA lo subas al repositorio.
#  3. Todos los valores de ejemplo son EXCLUSIVOS PARA DESARROLLO LOCAL.
#     No los reutilices en ningún entorno compartido o productivo.
# =====================================================================

# ---------------------------------------------------------------------
# Entorno de ASP.NET Core dentro de los contenedores
# ---------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------
# Puertos publicados en el host (solo en 127.0.0.1).
# Cámbialos si alguno ya está ocupado en tu equipo.
# ---------------------------------------------------------------------
FRONTEND_PORT=4200
GATEWAY_PORT=8080
BENEFICIARIOS_API_PORT=8081
SOLICITUDES_API_PORT=8082
SQLSERVER_PORT=14333
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
LOCALSTACK_PORT=4566
OLLAMA_PORT=11434

# ---------------------------------------------------------------------
# SQL Server
# La contraseña debe cumplir la política de SQL Server:
# mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# ---------------------------------------------------------------------
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=SocialMgmt_Dev_Only_2026!

# ---------------------------------------------------------------------
# RabbitMQ (usuario de desarrollo; el usuario "guest" queda limitado a localhost)
# ---------------------------------------------------------------------
RABBITMQ_USER=sm_dev
RABBITMQ_PASSWORD=sm_dev_only_password
RABBITMQ_VHOST=social-management

# ---------------------------------------------------------------------
# LocalStack (perfil opcional "localstack")
# Obtén un token gratuito (plan Hobby, uso no comercial) en
# https://app.localstack.cloud  ->  Settings  ->  Auth Tokens
# Déjalo vacío si no usarás LocalStack: el resto del entorno funciona igual.
# ---------------------------------------------------------------------
LOCALSTACK_AUTH_TOKEN=

# Credenciales AWS FICTICIAS: solo válidas contra LocalStack.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_USE_LOCALSTACK=true
AWS_S3_DOCUMENTS_BUCKET=social-management-documents-dev
AWS_SQS_NOTIFICATIONS_QUEUE=social-management-notifications-dev

# ---------------------------------------------------------------------
# Documentación de las APIs: Swagger UI y OpenAPI (ver docs/api-documentation.md)
# Si defines usuario Y clave (mínimo 12 caracteres), /swagger y /openapi exigen HTTP Basic.
# ---------------------------------------------------------------------
API_DOCS_ENABLED=true
API_DOCS_USER=
API_DOCS_PASSWORD=

# ---------------------------------------------------------------------
# Ollama (perfil opcional "ollama"). Ningún modelo se descarga automáticamente.
# ---------------------------------------------------------------------
OLLAMA_ENABLED=false
OLLAMA_MODEL=
